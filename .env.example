# Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
# Required for query-time generation only (Phase 4+).
# The ingestion pipeline needs NO model credentials — embeddings are local
# and the LLM is only used at query time (ARCH §8.1). The daily GitHub Actions
# workflow therefore holds no GROQ_API_KEY at all.
GROQ_API_KEY=

# Optional overrides (defaults live in mf_faq/settings.py)
# MF_FAQ_MODEL=openai/gpt-oss-120b
# MF_FAQ_SIMILARITY_FLOOR=0.35
# MF_FAQ_TOP_K=4
# MF_FAQ_LOG_LEVEL=INFO
